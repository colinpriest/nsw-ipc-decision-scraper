# Generated outputs. Everything this pipeline writes now lives under output/
# (see OUTPUT_ROOT in nsw_court_scraper.py) — cache, sidecar, CSV reports, the
# workbook, the run manifest, the log, and pre-transform backups.
output/

# Legacy root-level paths, kept so an old checkout does not accidentally commit
# a 100MB cache before migrate_legacy_outputs() moves it.
# Cache and data files
processed_cache.json
processed_sidecar.json
extraction_cache.json
*.cache
*.bak
# Operational backup snapshots taken before destructive cache transforms
processed_cache.json.pre_*
processed_cache.json.prepurge_*
processed_cache.json.preretry_*
processed_cache.json.corrupted*
# Pre-v3 migration backups (large data snapshots, not source)
*.pre-v3-backup.*
# Operational data artifact: generated legal-case error log (ISSUE-010).
# Contains litigant names / URLs; tracked sample is austlii_data_errors.sample.json
austlii_data_errors.json
# Run metadata + lock + live-smoke output (operational, not source)
run_manifest.json
.nsw_dataset.lock
smoke_full_sample_output.txt

# Local analysis outputs (not source)
ctp_impairment_lump_sum.xlsx
analysis_ready_payout_summary.csv

